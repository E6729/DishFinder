@model DishFinder.Models.Stall

@{
    ViewData["Title"] = Model.Name;
}

<h1>@Model.Name</h1>
<p>@Model.Description</p>
<p class="text-muted">@Model.Location</p>

<p><a asp-action="Index">Back to Stalls</a></p>

@if (Model.MenuItems.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Availability</th>
                <th>            </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.MenuItems)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@($"₱{item.Price:N2}")</td>
                    <td>@(item.IsAvailable ? "Available" : "Sold out")</td>
                    <td>@if(item.IsAvailable == true){
                            <form asp-controller="Cart" asp-action="Add" method="post">
                                <input type="hidden" name="MenuItemId" value="@item.Id"/>
                                <button type="submit" class="btn btn-primary btn-sm">Order</button>
                                Order
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-sm" disabled>Sold Out</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>This stall has no menu items yet.</p>
}