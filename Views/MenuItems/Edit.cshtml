@model DishFinder.Models.MenuItem

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>MenuItem</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IsAvailable" class="control-label">In Stock?</label>
                <input asp-for="IsAvailable" class="form-check-input" />
                <span asp-validation-for="IsAvailable" class="text-danger"></span>
            </div>
            @*<div class="form-group">
                <label asp-for="StallId" class="control-label"></label>
                <input asp-for="StallId" class="form-control" />
                <span asp-validation-for="StallId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Stall" class="control-label"></label>
                <input asp-for="Stall" class="form-control" />
                <span asp-validation-for="Stall" class="text-danger"></span>
            </div>*@
            <div class="form-group mb-3">
                <label asp-for="StallId" class="control-label">Stall</label>
                <select asp-for="StallId" class="form-control" asp-items="ViewBag.StallId">
                    <option value="">-- Select a Stall --</option>
                </select>
                <span asp-validation-for="StallId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
